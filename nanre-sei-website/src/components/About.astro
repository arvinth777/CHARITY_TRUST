---
// src/components/About.astro
import { siteConfig } from '../config/site';
const { about, registrationNo } = siteConfig;
---

<section id="about" class="about-section section-pad">
  <div class="section-container">
    <div class="about-grid">

      <!-- Left: Text Content -->
      <div class="about-text">
        <span class="section-eyebrow">
          <span class="lang-en">Est. 2018 · Coimbatore</span>
          <span class="lang-ta">நிறுவப்பட்டது 2018 · கோயம்புத்தூர்</span>
        </span>

        <h2 class="about-heading">
          <span class="lang-en">Welcome to Nanre Sei Public Charitable Trust</span>
          <span class="lang-ta">நன்றே செய் பொதுநல அறக்கட்டளைக்கு வரவேற்கிறோம்</span>
        </h2>

        <p class="about-story">
          <span class="lang-en">Advocate G.P. Sakthivel founded Nanre Sei Public Charitable Trust in 2018 to support children from underprivileged backgrounds. Our goal is to ensure they don't drop out of school due to financial hardships.</span>
          <span class="lang-ta">நன்றே செய் பொதுநல அறக்கட்டளை சமூக, பொருளாதாரத்தில் பின்தங்கிய பிரிவினைச் சார்ந்த குழந்தைகளின் மகிழ்ச்சியான குழந்தைப் பருவத்தை உறுதி செய்யவும், பள்ளிக்கல்வி இடைநிற்றலை தடுக்கும் நோக்கிலும் கடந்த 2018 ம் ஆண்டு வழக்குரைஞர் G.P.சக்திவேல் அவர்களால் துவங்கப்பட்டது.</span>
        </p>

        <p class="about-story about-story-2">
          <span class="lang-en">We work directly with government schools and local communities to identify students who need support the most, providing them with the necessary educational and mobility resources.</span>
          <span class="lang-ta">துவங்கப்பட்ட காலம் முதல் இலக்கு வைக்கப்பட்ட குழந்தைகளை இனங்கண்டு, அக்குழந்தைகள் தற்சார்புடன் வளர்வதற்கு தேவையான அனைத்தையும் வழங்கி வருகிறோம்.</span>
        </p>

        <!-- Three Pillars -->
        <div class="about-pillars">

          <div class="pillar">
            <div class="pillar-icon pillar-icon-orange">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><path d="M15 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-3 11.5V14l-3-3 4-3 2 3h2"/></svg>
            </div>
            <div class="pillar-text">
              <h4>
                <span class="lang-en">Educational Materials & Bicycles</span>
                <span class="lang-ta">குழந்தைகளுக்கு இலவச உபகரணங்கள்</span>
              </h4>
              <p>
                <span class="lang-en">We distribute schoolbooks, bicycles, and sports equipment to ensure students have the basics needed to attend and succeed in school.</span>
                <span class="lang-ta">விளையாட்டு உபகரணங்கள், மிதிவண்டிகள், அறிவை வளர்க்கும் புத்தகங்கள், பள்ளி பாடப்புத்தகங்கள் உள்ளிட்டவற்றை இலவசமாக வழங்கி வருகிறது.</span>
              </p>
            </div>
          </div>

          <div class="pillar">
            <div class="pillar-icon pillar-icon-blue">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <div class="pillar-text">
              <h4>
                <span class="lang-en">Free Evening Tuition</span>
                <span class="lang-ta">சமூகத்திலேயே இலவச மாலை வகுப்புகள்</span>
              </h4>
              <p>
                <span class="lang-en">We run free after-school tuition centers in local neighborhoods to provide continuous academic support for government school students.</span>
                <span class="lang-ta">அக்குழந்தைகள் வசிக்கும் பகுதிகளிலேயே மாலை நேர பள்ளி பாட வகுப்புகள் இலவசமாக நடைபெற்று வருகிறது. மாணவர்களின் கற்றல் திறன் தொடர்ந்து பரிசோதிக்கப்பட்டு திறன் மேம்பாடு உறுதி செய்யப்படுகிறது.</span>
              </p>
            </div>
          </div>

          <div class="pillar">
            <div class="pillar-icon pillar-icon-green">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="8 21 12 17 16 21"/><line x1="12" y1="17" x2="12" y2="11"/><path d="M7 4H4a2 2 0 0 0-2 2v1a4 4 0 0 0 4 4h16a4 4 0 0 0 4-4V6a2 2 0 0 0-2-2h-3"/><rect x="5" y="2" width="14" height="9" rx="2"/></svg>
            </div>
            <div class="pillar-text">
              <h4>
                <span class="lang-en">Cultural & Sports Competitions</span>
                <span class="lang-ta">போட்டிகளும் கலை நிகழ்ச்சிகளும்</span>
              </h4>
              <p>
                <span class="lang-en">We organize regular art, literary, and sports competitions to help children explore their interests outside of academics.</span>
                <span class="lang-ta">இவ்வகுப்புகளில் பயிலும் குழந்தைகளுக்கு பல்வேறு வகையான போட்டிகள், கலை நிகழ்ச்சிகள் நடத்தப்பட்டு, அவர்களது விருப்பத் திறன் வெளிக்கொணர முயற்சி மேற்கொள்ளப்படுகிறது.</span>
              </p>
            </div>
          </div>

        </div>

        <!-- Flat Registration Text -->
        <div class="reg-text">
          <span class="lang-en"><strong>Registered Charitable Trust</strong><br/>Reg. No. {registrationNo} · Tamil Nadu, 2018</span>
          <span class="lang-ta"><strong>பதிவு செய்யப்பட்ட அறக்கட்டளை</strong><br/>பதிவு எண். {registrationNo} · தமிழ்நாடு, 2018</span>
        </div>

        <a href="#donate" class="about-cta">
          <span class="lang-en">Support Our Cause →</span>
          <span class="lang-ta">எங்கள் காரணத்தை ஆதரிக்கவும் →</span>
        </a>
        <a href="#trustees" class="about-trustees-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span class="lang-en">Meet Our Trustees</span>
          <span class="lang-ta">எங்கள் அறங்காவலர்களை சந்திக்கவும்</span>
        </a>
      </div>

      <!-- Right: Framed Image + stat chips -->
      <div class="about-image-wrapper">
        <div class="about-image-frame">
          <img
            src={about.welcomePhoto}
            alt="Nanre Sei Trust community work"
            width="520"
            height="580"
            loading="lazy"
            class="about-img"
          />
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .about-section {
    background: white;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }



  .about-heading {
    font-family: 'Playfair Display', 'Noto Serif Tamil', serif;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 700;
    color: #1E3A8A;
    line-height: 1.25;
    margin-bottom: 1.5rem;
  }

  .about-story {
    font-size: 1.05rem;
    color: #374151;
    line-height: 1.8;
    margin-bottom: 1.75rem;
  }

  .about-story-2 {
    margin-top: -0.75rem;
    font-size: 0.97rem;
    color: #6B7280;
  }

  /* Three Pillars */
  .about-pillars {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-bottom: 1.75rem;
  }

  .pillar {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 0.75rem 0;
  }

  .pillar-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pillar-icon-orange { background: #FFF7ED; color: #C2410C; }
  .pillar-icon-blue   { background: #EFF6FF; color: #1E3A8A; }
  .pillar-icon-green  { background: #F0FDF4; color: #166534; }

  .pillar-text h4 {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1C1917;
    margin-bottom: 0.3rem;
    line-height: 1.3;
  }

  .pillar-text p {
    font-size: 0.85rem;
    color: #6B7280;
    line-height: 1.6;
    margin: 0;
  }

  /* Registration Text */
  .reg-text {
    font-size: 0.95rem;
    color: #4B5563;
    line-height: 1.6;
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 3px solid #C2410C;
  }

  .about-cta {
    display: inline-block;
    background: #C2410C;
    color: white;
    padding: 0.8rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px rgba(194, 65, 12, 0.3);
  }

  .about-cta:hover {
    background: #9A3412;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(194, 65, 12, 0.4);
  }

  .about-trustees-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #1E3A8A;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    margin-top: 0.75rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    border: 1.5px solid #BFDBFE;
    background: #EFF6FF;
    transition: all 0.2s ease;
  }

  .about-trustees-link:hover {
    background: #1E3A8A;
    color: white;
    border-color: #1E3A8A;
    transform: translateY(-1px);
  }

  /* Image Frame */
  .about-image-wrapper {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
  }

  .about-img {
    width: 100%;
    height: 520px;
    object-fit: cover;
    display: block;
    border-radius: 12px;
  }

  /* Responsive */
  @media (max-width: 1023px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .about-image-wrapper { order: -1; }
    .about-img { height: 380px; }
  }

  @media (max-width: 640px) {
    .about-img { height: 260px; }
  }
</style>
