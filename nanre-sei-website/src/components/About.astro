---
// src/components/About.astro
import { siteConfig } from '../config/site';
const { about, registrationNo } = siteConfig;
---

<section id="about" class="about-section section-pad">
  <div class="section-container">
    <div class="about-grid">

      <!-- Left: Text Content -->
      <div class="about-text">
        <span class="about-badge">
          <span class="lang-en">Est. 2018 · Coimbatore</span>
          <span class="lang-ta">நிறுவப்பட்டது 2018 · கோயம்புத்தூர்</span>
        </span>

        <h2 class="about-heading">
          <span class="lang-en">Welcome to Nanre Sei Public Charitable Trust</span>
          <span class="lang-ta">நன்றே செய் பொதுநல அறக்கட்டளைக்கு வரவேற்கிறோம்</span>
        </h2>

        <p class="about-story">
          <span class="lang-en">Advocate G.P. Sakthivel started the Nandre Sei Public Welfare Trust in 2018 with a simple but powerful mission: to give kids from struggling families a happy childhood and keep them from dropping out of school.</span>
          <span class="lang-ta">நன்றே செய் பொதுநல அறக்கட்டளை சமூக, பொருளாதாரத்தில் பின்தங்கிய பிரிவினைச் சார்ந்த குழந்தைகளின் மகிழ்ச்சியான குழந்தைப் பருவத்தை உறுதி செய்யவும், பள்ளிக்கல்வி இடைநிற்றலை தடுக்கும் நோக்கிலும் கடந்த 2018 ம் ஆண்டு வழக்குரைஞர் G.P.சக்திவேல் அவர்களால் துவங்கப்பட்டது.</span>
        </p>

        <p class="about-story about-story-2">
          <span class="lang-en">Since the beginning, we have focused on finding the children who need the most help and giving them everything they need to grow up independent and confident.</span>
          <span class="lang-ta">துவங்கப்பட்ட காலம் முதல் இலக்கு வைக்கப்பட்ட குழந்தைகளை இனங்கண்டு, அக்குழந்தைகள் தற்சார்புடன் வளர்வதற்கு தேவையான அனைத்தையும் வழங்கி வருகிறோம்.</span>
        </p>

        <!-- Three Pillars -->
        <div class="about-pillars">

          <div class="pillar">
            <div class="pillar-icon pillar-icon-orange">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><path d="M15 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-3 11.5V14l-3-3 4-3 2 3h2"/></svg>
            </div>
            <div class="pillar-text">
              <h4>
                <span class="lang-en">Equipping Kids for Success</span>
                <span class="lang-ta">குழந்தைகளுக்கு இலவச உபகரணங்கள்</span>
              </h4>
              <p>
                <span class="lang-en">We provide free schoolbooks, reading materials, bicycles, and sports gear — completely removing financial barriers to education.</span>
                <span class="lang-ta">விளையாட்டு உபகரணங்கள், மிதிவண்டிகள், அறிவை வளர்க்கும் புத்தகங்கள், பள்ளி பாடப்புத்தகங்கள் உள்ளிட்டவற்றை இலவசமாக வழங்கி வருகிறது.</span>
              </p>
            </div>
          </div>

          <div class="pillar">
            <div class="pillar-icon pillar-icon-blue">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <div class="pillar-text">
              <h4>
                <span class="lang-en">Bringing the Classroom to the Community</span>
                <span class="lang-ta">சமூகத்திலேயே இலவச மாலை வகுப்புகள்</span>
              </h4>
              <p>
                <span class="lang-en">Free evening tutoring right in their own neighbourhoods — and we regularly check in on their progress to ensure they are truly learning and growing.</span>
                <span class="lang-ta">அக்குழந்தைகள் வசிக்கும் பகுதிகளிலேயே மாலை நேர பள்ளி பாட வகுப்புகள் இலவசமாக நடைபெற்று வருகிறது. மாணவர்களின் கற்றல் திறன் தொடர்ந்து பரிசோதிக்கப்பட்டு திறன் மேம்பாடு உறுதி செய்யப்படுகிறது.</span>
              </p>
            </div>
          </div>

          <div class="pillar">
            <div class="pillar-icon pillar-icon-green">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="8 21 12 17 16 21"/><line x1="12" y1="17" x2="12" y2="11"/><path d="M7 4H4a2 2 0 0 0-2 2v1a4 4 0 0 0 4 4h16a4 4 0 0 0 4-4V6a2 2 0 0 0-2-2h-3"/><rect x="5" y="2" width="14" height="9" rx="2"/></svg>
            </div>
            <div class="pillar-text">
              <h4>
                <span class="lang-en">Celebrating Hidden Talents</span>
                <span class="lang-ta">போட்டிகளும் கலை நிகழ்ச்சிகளும்</span>
              </h4>
              <p>
                <span class="lang-en">Vibrant cultural programs and friendly competitions through our evening classes — giving every child a stage to shine and discover their unique talents.</span>
                <span class="lang-ta">இவ்வகுப்புகளில் பயிலும் குழந்தைகளுக்கு பல்வேறு வகையான போட்டிகள், கலை நிகழ்ச்சிகள் நடத்தப்பட்டு, அவர்களது விருப்பத் திறன் வெளிக்கொணர முயற்சி மேற்கொள்ளப்படுகிறது.</span>
              </p>
            </div>
          </div>

        </div>

        <!-- Registration Badge -->
        <div class="reg-badge">
          <div class="reg-badge-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <div>
            <div class="reg-badge-label">
              <span class="lang-en">Registered Charitable Trust</span>
              <span class="lang-ta">பதிவு செய்யப்பட்ட அறக்கட்டளை</span>
            </div>
            <div class="reg-badge-number">Reg. No. {registrationNo}</div>
            <div class="reg-badge-year">
              <span class="lang-en">Tamil Nadu Charitable Trust, 2018</span>
              <span class="lang-ta">தமிழ்நாடு அறக்கட்டளை, 2018</span>
            </div>
          </div>
        </div>

        <a href="#donate" class="about-cta">
          <span class="lang-en">Support Our Cause →</span>
          <span class="lang-ta">எங்கள் காரணத்தை ஆதரிக்கவும் →</span>
        </a>
        <a href="#trustees" class="about-trustees-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span class="lang-en">Meet Our Trustees</span>
          <span class="lang-ta">எங்கள் அறங்காவலர்களை சந்திக்கவும்</span>
        </a>
      </div>

      <!-- Right: Framed Image + stat chips -->
      <div class="about-image-wrapper">
        <div class="about-image-frame">
          <img
            src={about.welcomePhoto}
            alt="Nanre Sei Trust community work"
            width="520"
            height="580"
            loading="lazy"
            class="about-img"
          />
        </div>
        <!-- Floating stat chips -->
        <div class="stat-chip stat-chip-top">
          <span class="stat-chip-num">50+</span>
          <span class="stat-chip-label">
            <span class="lang-en">Bicycles gifted</span>
            <span class="lang-ta">சைக்கிள்கள்</span>
          </span>
        </div>
        <div class="stat-chip stat-chip-bottom">
          <span class="stat-chip-num">200+</span>
          <span class="stat-chip-label">
            <span class="lang-en">Students in tuition</span>
            <span class="lang-ta">மாணவர்கள்</span>
          </span>
        </div>
        <div class="deco-dot deco-dot-1"></div>
        <div class="deco-dot deco-dot-2"></div>
      </div>

    </div>
  </div>
</section>

<style>
  .about-section {
    background: white;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  /* Text */
  .about-badge {
    display: inline-block;
    background: #FFF7ED;
    color: #C2410C;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.35rem 1rem;
    border-radius: 100px;
    margin-bottom: 1.25rem;
    border: 1px solid #FDBA74;
  }

  .about-heading {
    font-family: 'Playfair Display', 'Noto Serif Tamil', serif;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 700;
    color: #1E3A8A;
    line-height: 1.25;
    margin-bottom: 1.5rem;
  }

  .about-story {
    font-size: 1.05rem;
    color: #374151;
    line-height: 1.8;
    margin-bottom: 1.75rem;
  }

  .about-story-2 {
    margin-top: -0.75rem;
    font-size: 0.97rem;
    color: #6B7280;
  }

  /* Three Pillars */
  .about-pillars {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-bottom: 1.75rem;
  }

  .pillar {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem 1.1rem;
    border-radius: 12px;
    border: 1px solid #E5E7EB;
    background: white;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .pillar:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.07);
    transform: translateX(4px);
  }

  .pillar-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pillar-icon-orange { background: #FFF7ED; color: #C2410C; }
  .pillar-icon-blue   { background: #EFF6FF; color: #1E3A8A; }
  .pillar-icon-green  { background: #F0FDF4; color: #166534; }

  .pillar-text h4 {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1C1917;
    margin-bottom: 0.3rem;
    line-height: 1.3;
  }

  .pillar-text p {
    font-size: 0.85rem;
    color: #6B7280;
    line-height: 1.6;
    margin: 0;
  }

  /* Registration Badge */
  .reg-badge {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: linear-gradient(135deg, #1E3A8A 0%, #1e40af 100%);
    color: white;
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    margin: 1.75rem 0;
    box-shadow: 0 4px 20px rgba(30, 58, 138, 0.25);
  }

  .reg-badge-icon {
    background: rgba(255,255,255,0.2);
    border-radius: 8px;
    padding: 0.5rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .reg-badge-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.85;
    margin-bottom: 0.2rem;
  }

  .reg-badge-number {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .reg-badge-year {
    font-size: 0.82rem;
    opacity: 0.75;
    margin-top: 0.15rem;
  }

  .about-cta {
    display: inline-block;
    background: #C2410C;
    color: white;
    padding: 0.8rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px rgba(194, 65, 12, 0.3);
  }

  .about-cta:hover {
    background: #9A3412;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(194, 65, 12, 0.4);
  }

  .about-trustees-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #1E3A8A;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    margin-top: 0.75rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    border: 1.5px solid #BFDBFE;
    background: #EFF6FF;
    transition: all 0.2s ease;
  }

  .about-trustees-link:hover {
    background: #1E3A8A;
    color: white;
    border-color: #1E3A8A;
    transform: translateY(-1px);
  }

  /* Image Frame */
  .about-image-wrapper {
    position: relative;
  }

  .about-image-frame {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    box-shadow:
      8px 8px 0 0 #C2410C,
      16px 16px 0 0 rgba(194, 65, 12, 0.15);
  }

  .about-image-frame::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 4px solid #1E3A8A;
    border-radius: 20px;
    z-index: 2;
    pointer-events: none;
  }

  .about-img {
    width: 100%;
    height: 520px;
    object-fit: cover;
    display: block;
    border-radius: 18px;
    transition: transform 0.5s ease;
  }

  .about-image-frame:hover .about-img {
    transform: scale(1.03);
  }

  /* Floating stat chips */
  .stat-chip {
    position: absolute;
    background: white;
    border-radius: 12px;
    padding: 0.65rem 1rem;
    box-shadow: 0 8px 24px rgba(0,0,0,0.14);
    display: flex;
    align-items: center;
    gap: 0.65rem;
    z-index: 5;
    border: 1px solid #F3F4F6;
  }

  .stat-chip-top    { top: 1.5rem; left: -2rem; }
  .stat-chip-bottom { bottom: 2rem; right: -1.5rem; }

  .stat-chip-num {
    font-size: 1.35rem;
    font-weight: 800;
    color: #C2410C;
    line-height: 1;
  }

  .stat-chip-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #6B7280;
    line-height: 1.3;
  }

  /* Decorative dots */
  .deco-dot {
    position: absolute;
    border-radius: 50%;
    opacity: 0.15;
  }

  .deco-dot-1 {
    width: 160px; height: 160px;
    background: #C2410C;
    top: -40px; right: -40px;
    z-index: -1;
  }

  .deco-dot-2 {
    width: 100px; height: 100px;
    background: #1E3A8A;
    bottom: -25px; left: -25px;
    z-index: -1;
  }

  /* Responsive */
  @media (max-width: 1023px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .about-image-wrapper { order: -1; }
    .about-img { height: 380px; }
    .stat-chip-top { left: 0.5rem; }
    .stat-chip-bottom { right: 0.5rem; }
  }

  @media (max-width: 640px) {
    .about-img { height: 260px; }
    .about-image-frame { box-shadow: 6px 6px 0 0 #C2410C; }
    .stat-chip { display: none; }
  }
</style>
