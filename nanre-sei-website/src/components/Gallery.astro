---
// src/components/Gallery.astro
import { siteConfig } from '../config/site';
const { gallery, galleryCategories } = siteConfig;
---

<section id="gallery" class="gallery-section section-pad">
  <div class="section-container">
    <!-- Breadcrumb -->
    <nav class="gallery-breadcrumb" aria-label="Breadcrumb">
      <span class="lang-en">Home &rsaquo; Gallery</span>
      <span class="lang-ta">முகப்பு &rsaquo; படங்கள்</span>
    </nav>

    <!-- Heading -->
    <div class="gallery-header">
      <h2 class="section-title">
        <span class="lang-en">Gallery</span>
        <span class="lang-ta">படங்கள்</span>
      </h2>

      <!-- Photo / Video toggle tabs -->
      <div class="gallery-tabs" role="tablist">
        <button class="gallery-tab active" data-tab="photo" role="tab" id="tab-photo">
          <span class="lang-en">📷 Photo Gallery</span>
          <span class="lang-ta">📷 புகைப்பட தொகுப்பு</span>
        </button>
        <button class="gallery-tab" data-tab="video" role="tab" id="tab-video">
          <span class="lang-en">🎬 Video Gallery</span>
          <span class="lang-ta">🎬 வீடியோ தொகுப்பு</span>
        </button>
      </div>
    </div>

    <!-- Photo tab content -->
    <div id="gallery-photo-content">
      <!-- Category Filter -->
      <div class="gallery-filters" role="group" aria-label="Gallery category filter">
        {galleryCategories.map(cat => (
          <button
            class={`gallery-filter-btn ${cat.id === 'all' ? 'active' : ''}`}
            data-gallery-filter={cat.id}
            id={`gallery-filter-${cat.id}`}
          >
            <span class="lang-en">{cat.label.en}</span>
            <span class="lang-ta">{cat.label.ta}</span>
          </button>
        ))}
      </div>

      <!-- Image Grid -->
      <div class="gallery-grid" id="gallery-grid">
        {gallery.map((item, i) => (
          <div
            class="gallery-card"
            data-category={item.category}
            style={`animation-delay: ${i * 0.06}s`}
          >
            <img
              src={item.src}
              alt=""
              width="400"
              height="300"
              loading="lazy"
              class="gallery-card-img"
            />
          </div>
        ))}
      </div>
    </div>

    <!-- Video tab content (placeholder) -->
    <div id="gallery-video-content" style="display:none">
      <div class="video-placeholder">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#C2410C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="23 7 16 12 23 17 23 7"></polygon>
          <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
        </svg>
        <p class="lang-en">Videos coming soon. Follow us on Facebook for event videos.</p>
        <p class="lang-ta">வீடியோக்கள் விரைவில் வருகின்றன. நிகழ்வு வீடியோக்களுக்கு Facebook இல் எங்களைப் பின்தொடருங்கள்.</p>
        <a href="https://www.facebook.com/nanreseitrust" target="_blank" rel="noopener" class="btn-facebook">
          Follow on Facebook
        </a>
      </div>
    </div>
  </div>

  <!-- Lightbox -->
  <div id="gallery-lightbox" class="lightbox" style="display:none" aria-hidden="true">
    <button class="lightbox-close" id="lightbox-close" aria-label="Close lightbox">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    <button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous image">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <img id="lightbox-img" src="" alt="Expanded gallery view" />
    <button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next image">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>
</section>

<script is:inline>
  // Gallery category filter
  const galleryFilterBtns = document.querySelectorAll('.gallery-filter-btn');
  const galleryCards = document.querySelectorAll('.gallery-card');

  galleryFilterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-gallery-filter');
      galleryFilterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      galleryCards.forEach(card => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          card.style.display = '';
          card.style.opacity = '0';
          requestAnimationFrame(() => {
            card.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
            card.style.opacity = '1';
            card.style.transform = 'scale(1)';
          });
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Photo / Video tab toggle
  document.getElementById('tab-photo')?.addEventListener('click', () => {
    document.getElementById('gallery-photo-content').style.display = '';
    document.getElementById('gallery-video-content').style.display = 'none';
    document.getElementById('tab-photo').classList.add('active');
    document.getElementById('tab-video').classList.remove('active');
  });

  document.getElementById('tab-video')?.addEventListener('click', () => {
    document.getElementById('gallery-photo-content').style.display = 'none';
    document.getElementById('gallery-video-content').style.display = '';
    document.getElementById('tab-video').classList.add('active');
    document.getElementById('tab-photo').classList.remove('active');
  });

  // Lightbox logic
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const btnClose = document.getElementById('lightbox-close');
  const btnPrev = document.getElementById('lightbox-prev');
  const btnNext = document.getElementById('lightbox-next');
  let currentImages = [];
  let currentIndex = 0;

  document.getElementById('gallery-grid')?.addEventListener('click', (e) => {
    const card = e.target.closest('.gallery-card');
    if (card) {
      currentImages = Array.from(document.querySelectorAll('.gallery-card')).filter(c => c.style.display !== 'none');
      currentIndex = currentImages.indexOf(card);
      if (currentIndex !== -1) {
        lightboxImg.src = card.querySelector('img').src;
        lightbox.style.display = 'flex';
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
    }
  });

  function updateLightboxImage() {
    if (currentImages.length > 0 && currentIndex >= 0) {
      lightboxImg.src = currentImages[currentIndex].querySelector('img').src;
    }
  }

  function hideLightbox() {
    lightbox.style.display = 'none';
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  btnClose?.addEventListener('click', hideLightbox);
  lightbox?.addEventListener('click', (e) => { if (e.target === lightbox) hideLightbox(); });

  btnPrev?.addEventListener('click', () => {
    currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length;
    updateLightboxImage();
  });

  btnNext?.addEventListener('click', () => {
    currentIndex = (currentIndex + 1) % currentImages.length;
    updateLightboxImage();
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox?.style.display === 'flex') {
      if (e.key === 'Escape') hideLightbox();
      if (e.key === 'ArrowLeft') btnPrev.click();
      if (e.key === 'ArrowRight') btnNext.click();
    }
  });
</script>

<style>
  .gallery-section {
    background: #F9FAFB;
  }

  .gallery-breadcrumb {
    font-size: 0.82rem;
    color: #6B7280;
    margin-bottom: 1.25rem;
    font-weight: 500;
  }

  .gallery-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  /* Tabs */
  .gallery-tabs {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }

  .gallery-tab {
    padding: 0.6rem 1.5rem;
    border-radius: 8px;
    border: 2px solid #E5E7EB;
    background: white;
    color: #6B7280;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: 'Lato', 'Noto Sans Tamil', sans-serif;
  }

  .gallery-tab.active {
    background: #C2410C;
    border-color: #C2410C;
    color: white;
  }

  .gallery-tab:not(.active):hover {
    border-color: #C2410C;
    color: #C2410C;
  }

  /* Category Filters */
  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .gallery-filter-btn {
    padding: 0.4rem 1rem;
    border-radius: 100px;
    border: 1.5px solid #E5E7EB;
    background: white;
    color: #374151;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: 'Lato', 'Noto Sans Tamil', sans-serif;
  }

  .gallery-filter-btn.active {
    background: #1E3A8A;
    border-color: #1E3A8A;
    color: white;
  }

  .gallery-filter-btn:not(.active):hover {
    border-color: #1E3A8A;
    color: #1E3A8A;
  }

  /* Grid — ViswaSanthi style */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .gallery-card {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4/3;
    cursor: pointer;
    animation: fadeInUp 0.5s ease both;
  }

  .gallery-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  .gallery-card:hover .gallery-card-img {
    transform: scale(1.05);
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .lightbox img {
    max-width: 90%;
    max-height: 90vh;
    border-radius: 6px;
    box-shadow: 0 4px 30px rgba(0,0,0,0.5);
    user-select: none;
  }
  
  .lightbox-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: rgba(255,255,255,0.1);
    border: none;
    color: white;
    cursor: pointer;
    padding: 0.75rem;
    border-radius: 50%;
    backdrop-filter: blur(4px);
    transition: background 0.2s;
  }
  
  .lightbox-close:hover { background: rgba(255,255,255,0.25); }
  
  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.1);
    border: none;
    color: white;
    padding: 1rem;
    cursor: pointer;
    border-radius: 50%;
    backdrop-filter: blur(4px);
    transition: background 0.2s;
  }
  
  .lightbox-nav:hover { background: rgba(255,255,255,0.25); }
  .lightbox-prev { left: 1.5rem; }
  .lightbox-next { right: 1.5rem; }

  /* Video placeholder */
  .video-placeholder {
    text-align: center;
    padding: 5rem 2rem;
    color: #6B7280;
  }

  .video-placeholder p {
    margin: 1.5rem 0 0.5rem;
    font-size: 1rem;
    max-width: 400px;
    margin-inline: auto;
    line-height: 1.7;
  }

  .btn-facebook {
    display: inline-block;
    margin-top: 1.25rem;
    background: #1877F2;
    color: white;
    padding: 0.7rem 1.75rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    transition: all 0.2s ease;
  }

  .btn-facebook:hover {
    background: #0f5ec9;
    transform: translateY(-2px);
  }

  @media (max-width: 1023px) {
    .gallery-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 768px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .gallery-grid { grid-template-columns: 1fr; gap: 0.75rem; }
    .lightbox-nav { padding: 0.5rem; }
    .lightbox-prev { left: 0.5rem; }
    .lightbox-next { right: 0.5rem; }
    .lightbox-close { top: 1rem; right: 1rem; padding: 0.5rem; }
  }
</style>
