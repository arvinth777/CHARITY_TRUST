---
// src/components/Contact.astro
import { siteConfig } from '../config/site';
const { contact, name } = siteConfig;
const { form } = contact;
---

<section id="contact" class="contact-section section-pad">
  <div class="section-container">
    <!-- Heading -->
    <div class="contact-header">
      <span class="section-eyebrow">
        <span class="lang-en">Get In Touch</span>
        <span class="lang-ta">தொடர்பு கொள்ளுங்கள்</span>
      </span>
      <h2 class="section-title">
        <span class="lang-en">Contact Us</span>
        <span class="lang-ta">எங்களை தொடர்பு கொள்ளுங்கள்</span>
      </h2>
    </div>

    <div class="contact-grid">
      <!-- Left: Contact Form (60%) -->
      <div class="contact-form-wrapper">
        <form class="contact-form" id="contact-form" novalidate>
          <div class="form-group">
            <label for="full-name">
              <span class="lang-en">{form.name.en} *</span>
              <span class="lang-ta">{form.name.ta} *</span>
            </label>
            <input
              type="text"
              id="full-name"
              name="fullName"
              required
              autocomplete="name"
              placeholder="Your full name / உங்கள் முழு பெயர்"
            />
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="email-id">
                <span class="lang-en">{form.email.en} *</span>
                <span class="lang-ta">{form.email.ta} *</span>
              </label>
              <input
                type="email"
                id="email-id"
                name="email"
                required
                autocomplete="email"
                placeholder="you@example.com / மின்னஞ்சல்"
              />
            </div>
            <div class="form-group">
              <label for="phone-number">
                <span class="lang-en">{form.phone.en} *</span>
                <span class="lang-ta">{form.phone.ta} *</span>
              </label>
              <input
                type="tel"
                id="phone-number"
                name="phone"
                required
                autocomplete="tel"
                placeholder="+91 98765 43210"
              />
            </div>
          </div>

          <div class="form-group">
            <label for="enquiry-type">
              <span class="lang-en">{form.enquiry.en} *</span>
              <span class="lang-ta">{form.enquiry.ta} *</span>
            </label>
            <select id="enquiry-type" name="enquiryType" required>
              <option value="" disabled selected>
                <span class="lang-en">Select enquiry type / விசாரணை வகையை தேர்ந்தெடுக்கவும்</span>
              </option>
              {form.enquiryOptions.map(opt => (
                <option value={opt.value}>
                  {opt.label.en} / {opt.label.ta}
                </option>
              ))}
            </select>
          </div>

          <div class="form-group">
            <label for="subject">
              <span class="lang-en">{form.subject.en} *</span>
              <span class="lang-ta">{form.subject.ta} *</span>
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              placeholder="Brief subject / பொருள்"
            />
          </div>

          <div class="form-group">
            <label for="message">
              <span class="lang-en">{form.message.en} *</span>
              <span class="lang-ta">{form.message.ta} *</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Your message... / உங்கள் செய்தி..."
            ></textarea>
          </div>

          <!-- reCAPTCHA placeholder -->
          <div class="recaptcha-placeholder">
            <div class="recaptcha-box">
              <input type="checkbox" id="not-robot" />
              <label for="not-robot">I'm not a robot / நான் ரோபோ அல்ல</label>
            </div>
          </div>

          <button type="submit" class="form-submit-btn" id="form-submit-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
            <span class="lang-en">{form.submit.en}</span>
            <span class="lang-ta">{form.submit.ta}</span>
          </button>

          <div id="form-success" class="form-success" style="display:none">
            <span class="lang-en">✓ Message sent! We'll get back to you soon.</span>
            <span class="lang-ta">✓ செய்தி அனுப்பப்பட்டது! நாங்கள் விரைவில் பதில் தருவோம்.</span>
          </div>
        </form>
      </div>

      <!-- Right: Info Cards (40%) -->
      <div class="contact-info">
        <!-- Address Card -->
        <div class="info-card">
          <div class="info-card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div class="info-card-content">
            <h4 class="lang-en">Our Address</h4>
            <h4 class="lang-ta">எங்கள் முகவரி</h4>
            <p class="lang-en">{contact.address.en}</p>
            <p class="lang-ta">{contact.address.ta}</p>
          </div>
        </div>

        <!-- Email Card -->
        <div class="info-card">
          <div class="info-card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div class="info-card-content">
            <h4 class="lang-en">Email Us</h4>
            <h4 class="lang-ta">மின்னஞ்சல் அனுப்புங்கள்</h4>
            <a href={`mailto:${contact.email}`} class="info-link">{contact.email}</a>
          </div>
        </div>

        <!-- WhatsApp Card -->
        <div class="info-card">
          <div class="info-card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
          </div>
          <div class="info-card-content">
            <h4 class="lang-en">WhatsApp</h4>
            <h4 class="lang-ta">வாட்ஸ்அப்</h4>
            <a href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener" class="info-link">
              <span class="lang-en">Chat on WhatsApp ↗</span>
              <span class="lang-ta">வாட்ஸ்அப்பில் பேசுங்கள் ↗</span>
            </a>
          </div>
        </div>

        <!-- Facebook Card -->
        <div class="info-card">
          <div class="info-card-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </div>
          <div class="info-card-content">
            <h4 class="lang-en">Follow Us</h4>
            <h4 class="lang-ta">எங்களைப் பின்தொடருங்கள்</h4>
            <a href={contact.facebook} target="_blank" rel="noopener" class="info-link">
              <span class="lang-en">Facebook Page ↗</span>
              <span class="lang-ta">ஃபேஸ்புக் பக்கம் ↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.getElementById('contact-form')?.addEventListener('submit', function (e) {
    e.preventDefault();
    // Since this is a static site, show a success message
    // In production, connect to Formspree or Netlify Forms
    document.getElementById('form-success').style.display = 'block';
    this.reset();
    setTimeout(() => {
      document.getElementById('form-success').style.display = 'none';
    }, 5000);
  });
</script>

<style>
  .contact-section {
    background: #F9FAFB;
  }

  .contact-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 60% 40%;
    gap: 3rem;
    align-items: start;
  }

  /* Form */
  .contact-form-wrapper {
    background: white;
    border-radius: 20px;
    padding: 2.5rem;
    box-shadow: 0 4px 24px rgba(0,0,0,0.07);
    border: 1px solid #E5E7EB;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #374151;
  }

  input, select, textarea {
    padding: 0.75rem 1rem;
    border: 1.5px solid #E5E7EB;
    border-radius: 10px;
    font-size: 0.95rem;
    font-family: 'Lato', 'Noto Sans Tamil', sans-serif;
    color: #1C1917;
    background: white;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    outline: none;
    width: 100%;
  }

  input:focus, select:focus, textarea:focus {
    border-color: #C2410C;
    box-shadow: 0 0 0 3px rgba(194, 65, 12, 0.1);
  }

  textarea { resize: vertical; min-height: 130px; }

  select { cursor: pointer; }

  /* reCAPTCHA placeholder */
  .recaptcha-placeholder {
    border: 1.5px solid #E5E7EB;
    border-radius: 10px;
    padding: 1rem 1.25rem;
    background: #F9FAFB;
  }

  .recaptcha-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.88rem;
    color: #374151;
    font-weight: 500;
  }

  .recaptcha-box input { width: auto; }

  .form-submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: #C2410C;
    color: white;
    border: none;
    padding: 1rem 2rem;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
    font-family: 'Lato', 'Noto Sans Tamil', sans-serif;
    width: 100%;
  }

  .form-submit-btn:hover {
    background: #9A3412;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(194, 65, 12, 0.35);
  }

  .form-success {
    text-align: center;
    padding: 1rem;
    background: #F0FDF4;
    border: 1px solid #86EFAC;
    border-radius: 10px;
    color: #166534;
    font-weight: 600;
    font-size: 0.95rem;
  }

  /* Info Cards */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .info-card {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    background: white;
    border: 1px solid #E5E7EB;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .info-card:hover {
    transform: translateX(5px);
    border-color: #D1D5DB;
  }

  .info-card-icon {
    background: #F3F4F6;
    color: #1E3A8A;
    border-radius: 10px;
    padding: 0.6rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .info-card-content h4 {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #6B7280;
    margin-bottom: 0.3rem;
  }

  .info-card-content p {
    font-size: 0.95rem;
    color: #1C1917;
    font-weight: 500;
    line-height: 1.5;
    margin: 0;
  }

  .info-link {
    color: #1E3A8A;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s;
  }

  .info-link:hover { color: #C2410C; text-decoration: underline; }

  /* Responsive */
  @media (max-width: 1023px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .form-row { grid-template-columns: 1fr; }
    .contact-form-wrapper { padding: 1.5rem; }
  }
</style>
