---
// src/components/Donate.astro
import { siteConfig } from '../config/site';
const { donate, contact, has80G } = siteConfig;
---

<section id="donate" class="donate-section section-pad">
  <div class="section-container">
    <div class="donate-wrapper">
      <!-- Heading -->
      <div class="donate-header">
        <span class="section-eyebrow">
          <span class="lang-en">Make a Difference</span>
          <span class="lang-ta">மாற்றத்தை உருவாக்குங்கள்</span>
        </span>
        <h2 class="section-title">
          <span class="lang-en">Donate to Nanre Sei Trust</span>
          <span class="lang-ta">நன்றே செய் அறக்கட்டளைக்கு நன்கொடை செய்யுங்கள்</span>
        </h2>
        <p class="section-desc">
          <span class="lang-en">Every rupee you give directly supports children's education, mobility, and opportunity in Coimbatore.</span>
          <span class="lang-ta">நீங்கள் வழங்கும் ஒவ்வொரு ரூபாயும் கோயம்புத்தூரில் குழந்தைகளின் கல்வி, இயக்கம் மற்றும் வாய்ப்புகளை நேரடியாக ஆதரிக்கிறது.</span>
        </p>
      </div>

      <!-- Donate Card -->
      <div class="donate-card">
        <!-- QR Code -->
        <div class="qr-section">
          <div class="qr-frame">
            <img
              src="/qr.png"
              alt="UPI QR Code for Nanre Sei Trust donation"
              width="260"
              height="260"
              loading="lazy"
              class="qr-image"
            />
          </div>
          <div class="qr-label">
            <span class="lang-en">Scan to Pay via UPI</span>
            <span class="lang-ta">UPI வழியாக செலுத்த ஸ்கேன் செய்யுங்கள்</span>
          </div>
        </div>

        <!-- UPI ID -->
        <div class="upi-section">
          <div class="upi-id-label">
            <span class="lang-en">UPI ID</span>
            <span class="lang-ta">UPI ஐடி</span>
          </div>
          <div class="upi-id-value" id="upi-id-value">{donate.upiId}</div>
          <button
            class="copy-btn"
            id="copy-upi-btn"
            onclick="copyUPI()"
            aria-label="Copy UPI ID"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="lang-en">Copy UPI ID</span>
            <span class="lang-ta">UPI ஐடி நகலெடு</span>
          </button>
        </div>

        <!-- Bank Details -->
        <div class="bank-details">
          <h4 class="bank-details-heading">
            <span class="lang-en">Bank Transfer Details</span>
            <span class="lang-ta">வங்கி பரிமாற்ற விவரங்கள்</span>
          </h4>
          <div class="bank-row">
            <span class="bank-key">
              <span class="lang-en">Account Name</span>
              <span class="lang-ta">கணக்கு பெயர்</span>
            </span>
            <span class="bank-val">{donate.accountName}</span>
          </div>
          <div class="bank-row">
            <span class="bank-key">
              <span class="lang-en">Account No.</span>
              <span class="lang-ta">கணக்கு எண்</span>
            </span>
            <span class="bank-val">{donate.accountNumber}</span>
          </div>
          <div class="bank-row">
            <span class="bank-key">IFSC</span>
            <span class="bank-val">{donate.ifsc}</span>
          </div>
          <div class="bank-row">
            <span class="bank-key">
              <span class="lang-en">Bank / Branch</span>
              <span class="lang-ta">வங்கி / கிளை</span>
            </span>
            <span class="bank-val">{donate.bankBranch}</span>
          </div>
        </div>

        <!-- Post-donation note -->
        <div class="donate-note">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C2410C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <p>
            <span class="lang-en">{donate.note.en} <a href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener" class="note-link">Message us on WhatsApp ↗</a></span>
            <span class="lang-ta">{donate.note.ta} <a href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener" class="note-link">வாட்ஸ்அப்பில் தொடர்பு கொள்ளுங்கள் ↗</a></span>
          </p>
        </div>

        <!-- 80G Note -->
        {has80G && (
          <div class="tax-note">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#166534" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <p>
              <span class="lang-en">{donate.exemptionNote.en}</span>
              <span class="lang-ta">{donate.exemptionNote.ta}</span>
            </p>
          </div>
        )}

        <!-- WhatsApp Button -->
        <a
          href={`https://wa.me/${contact.whatsapp}`}
          target="_blank"
          rel="noopener"
          class="whatsapp-btn"
          id="donate-whatsapp-btn"
          aria-label="Open WhatsApp"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
          </svg>
          <span class="lang-en">Chat on WhatsApp</span>
          <span class="lang-ta">வாட்ஸ்அப்பில் பேசுங்கள்</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  function copyUPI() {
    const upiId = document.getElementById('upi-id-value')?.textContent?.trim();
    if (upiId) {
      navigator.clipboard.writeText(upiId).then(() => {
        const btn = document.getElementById('copy-upi-btn');
        const originalHTML = btn.innerHTML;
        btn.innerHTML = '<span style="color:#166534">✓ Copied!</span>';
        setTimeout(() => { btn.innerHTML = originalHTML; }, 2000);
      }).catch(() => {});
    }
  }
</script>

<style>
  .donate-section {
    background: linear-gradient(135deg, #FFF7ED 0%, #FFFFFF 50%, #EFF6FF 100%);
  }

  .donate-wrapper {
    max-width: 560px;
    margin: 0 auto;
  }

  .donate-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .donate-card {
    background: white;
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: 0 8px 48px rgba(0,0,0,0.1);
    border: 1px solid #E5E7EB;
  }

  /* QR */
  .qr-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 1.75rem;
  }

  .qr-frame {
    padding: 0.75rem;
    border: 3px solid #C2410C;
    border-radius: 16px;
    background: white;
    display: inline-flex;
    box-shadow: 0 4px 16px rgba(194,65,12,0.15);
    margin-bottom: 0.75rem;
  }

  .qr-image {
    width: 260px;
    height: 260px;
    object-fit: contain;
    border-radius: 8px;
    display: block;
  }

  .qr-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: #6B7280;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* UPI */
  .upi-section {
    text-align: center;
    background: #F9FAFB;
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    border: 1px dashed #E5E7EB;
  }

  .upi-id-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #6B7280;
    margin-bottom: 0.3rem;
  }

  .upi-id-value {
    font-size: 1.2rem;
    font-weight: 800;
    color: #1E3A8A;
    font-family: monospace;
    margin-bottom: 0.75rem;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 8px;
    border: 1.5px solid #C2410C;
    background: transparent;
    color: #C2410C;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: 'Lato', 'Noto Sans Tamil', sans-serif;
  }

  .copy-btn:hover {
    background: #C2410C;
    color: white;
  }

  /* Bank Details */
  .bank-details {
    background: #F9FAFB;
    border-radius: 12px;
    padding: 1.25rem;
    margin-bottom: 1.5rem;
    border: 1px solid #E5E7EB;
  }

  .bank-details-heading {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #1E3A8A;
    margin-bottom: 0.75rem;
  }

  .bank-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 0.4rem 0;
    border-bottom: 1px solid #E5E7EB;
    gap: 1rem;
    font-size: 0.88rem;
  }

  .bank-row:last-child { border-bottom: none; }

  .bank-key {
    color: #6B7280;
    font-weight: 500;
    flex-shrink: 0;
  }

  .bank-val {
    color: #1C1917;
    font-weight: 600;
    text-align: right;
    word-break: break-all;
  }

  /* Donate Note */
  .donate-note {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem;
    border-radius: 10px;
    background: #FFF7ED;
    border: 1px solid #FDBA74;
    margin-bottom: 1rem;
  }

  .donate-note p {
    font-size: 0.88rem;
    color: #374151;
    line-height: 1.6;
    margin: 0;
  }

  .note-link {
    color: #C2410C;
    font-weight: 700;
    text-decoration: none;
  }

  .note-link:hover { text-decoration: underline; }

  .tax-note {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem;
    border-radius: 10px;
    background: #F0FDF4;
    border: 1px solid #86EFAC;
    margin-bottom: 1rem;
    font-size: 0.88rem;
    color: #166534;
  }

  /* WhatsApp Button */
  .whatsapp-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.9rem;
    background: #25D366;
    color: white;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    transition: all 0.25s ease;
    margin-top: 0.5rem;
  }

  .whatsapp-btn:hover {
    background: #1ebe5a;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(37,211,102,0.35);
  }

  @media (max-width: 480px) {
    .donate-card { padding: 1.5rem; }
    .qr-image { width: 200px; height: 200px; }
  }
</style>
