---
// src/components/Hero.astro
import { siteConfig } from '../config/site';
const { heroSlides } = siteConfig;
---

<section id="hero" class="hero" aria-label="Hero banner">
  <!-- Watermark Logo -->
  <div class="hero-watermark">
    <img src="/watermark-logo.jpg" alt="" aria-hidden="true" />
  </div>

  <!-- Static Content -->
  <div class="hero-static" aria-label="Hero content">
    <div class="slide-bg"></div>
    <div class="hero-content">
      <div class="hero-eyebrow">
        <span class="lang-en">Reg. No. {siteConfig.registrationNo} · Coimbatore, Tamil Nadu</span>
        <span class="lang-ta">பதிவு எண். {siteConfig.registrationNo} · கோயம்புத்தூர், தமிழ்நாடு</span>
      </div>
      <h1 class="hero-title">
        <span class="lang-en">Education &amp; Mobility<br/>For Every Child</span>
        <span class="lang-ta">ஒவ்வொரு குழந்தைக்கும்<br/>கல்வியும் இயக்கமும்</span>
      </h1>
      <p class="hero-subtitle">
        <span class="lang-en">Nanre Sei Public Charitable Trust empowers rural and underprivileged students through bicycles, books, and free evening tuition.</span>
        <span class="lang-ta">நன்றே செய் பொதுநல அறக்கட்டளை மிதிவண்டிகள், புத்தகங்கள் மற்றும் மாலை நேர பயிற்சி மூலம் மாணவர்களை மேம்படுத்துகிறது.</span>
      </p>
      <div class="hero-ctas">
        <a href="#donate" class="btn-primary"><span class="lang-en">Donate Now</span><span class="lang-ta">நன்கொடை செய்யுங்கள்</span></a>
        <a href="#work" class="btn-ghost"><span class="lang-en">Our Programs</span><span class="lang-ta">எங்கள் திட்டங்கள்</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: max(100svh, 680px);
    overflow: hidden;
  }

  .hero-watermark {
    position: absolute;
    top: 50%;
    right: 5%;
    transform: translateY(-50%);
    z-index: 1;
    opacity: 0.45;
    pointer-events: none;
  }

  .hero-watermark img {
    width: 450px;
    height: auto;
    border-radius: 50%;
  }

  /* Static Background */
  .slide-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #1E3A8A; /* Deep Blue matching logo */
  }

  .hero-static {
    position: absolute;
    inset: 0;
  }

  /* Content */
  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-top: 88px;
  }

  .hero-eyebrow {
    display: inline-block;
    color: #FDBA74;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    animation: heroTextIn 0.8s ease both;
  }

  .hero-title {
    font-family: 'Playfair Display', 'Noto Serif Tamil', serif;
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 800;
    color: white;
    line-height: 1.15;
    max-width: 680px;
    margin-bottom: 1.25rem;
    animation: heroTextIn 0.8s 0.1s ease both;
  }

  .hero-subtitle {
    font-size: clamp(0.95rem, 2vw, 1.2rem);
    color: rgba(255, 255, 255, 0.82);
    max-width: 540px;
    margin-bottom: 2.5rem;
    font-weight: 400;
    line-height: 1.65;
    animation: heroTextIn 0.8s 0.2s ease both;
  }

  @keyframes heroTextIn {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    animation: heroTextIn 0.8s 0.3s ease both;
  }

  .btn-primary {
    display: inline-block;
    background: #C2410C;
    color: white;
    padding: 0.9rem 2.25rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.05rem;
    transition: all 0.25s ease;
    box-shadow: 0 4px 18px rgba(194, 65, 12, 0.45);
  }

  .btn-primary:hover {
    background: #9A3412;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(194, 65, 12, 0.5);
  }

  .btn-ghost {
    display: inline-block;
    border: 2px solid rgba(255,255,255,0.85);
    color: white;
    padding: 0.9rem 2rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.05rem;
    transition: all 0.25s ease;
    backdrop-filter: blur(4px);
  }

  .btn-ghost:hover {
    background: rgba(255,255,255,0.18);
    border-color: white;
    transform: translateY(-2px);
  }



  /* Mobile */
  @media (max-width: 1023px) {
    .hero-watermark { right: 2%; }
    .hero-watermark img { width: 350px; }
  }

  @media (max-width: 640px) {
    .hero { min-height: 80svh; }
    .hero-content { padding: 0 1.5rem; }
    .hero-ctas { flex-direction: column; }
    .btn-primary, .btn-ghost { text-align: center; padding: 0.8rem 1.5rem; }
    .hero-watermark { right: 0%; }
    .hero-watermark img { width: 250px; }
  }
</style>
