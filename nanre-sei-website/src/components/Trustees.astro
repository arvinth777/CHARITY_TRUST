---
// src/components/Trustees.astro

const trustees = [
  {
    name:    "G.P. Sakthivel",
    nameTA:  "ஜி.பி. சக்திவேல்",
    role:    "Managing Trustee",
    roleTA:  "நிர்வாக அறங்காவலர்",
    parent:  "S/o G.K. Panchanatham",
    city:    "Singanallur, Coimbatore",
    initials:"GS",
    initialsTA:"ஜி.பி",
    color:   "avatar-orange",
  },
  {
    name:    "J. Balaram",
    nameTA:  "ஜே. பாலாராம்",
    role:    "Secretary",
    roleTA:  "செயலாளர்",
    parent:  "S/o Jayaraman",
    city:    "Whitefield, Bengaluru",
    initials:"JB",
    initialsTA:"ஜே.பா",
    color:   "avatar-blue",
  },
  {
    name:    "M. Saravana Dharshan",
    nameTA:  "எம். சரவண தர்ஷன்",
    role:    "Treasurer",
    roleTA:  "பொருளாளர்",
    parent:  "S/o Muthukrishnan",
    city:    "Goldwins, Coimbatore",
    initials:"SD",
    initialsTA:"எம்.ச",
    color:   "avatar-green",
  },
  {
    name:    "K. Bharath",
    nameTA:  "கே. பரத்",
    role:    "Trustee",
    roleTA:  "அறங்காவலர்",
    parent:  "S/o Kannan",
    city:    "Madiwala, Bengaluru",
    initials:"KB",
    initialsTA:"கே.ப",
    color:   "avatar-purple",
  },
  {
    name:    "P. Prabhu",
    nameTA:  "பி. பிரபு",
    role:    "Trustee",
    roleTA:  "அறங்காவலர்",
    parent:  "S/o Palanisamy",
    city:    "Veerapandi, Tiruppur",
    initials:"PP",
    initialsTA:"பி.பி",
    color:   "avatar-teal",
  },
  {
    name:    "M. Balasubramanian",
    nameTA:  "எம். பாலசுப்ரமணியன்",
    role:    "Trustee",
    roleTA:  "அறங்காவலர்",
    parent:  "S/o Murugesan",
    city:    "Jawahar Nagar, Chennai",
    initials:"MB",
    initialsTA:"எம்.பா",
    color:   "avatar-rose",
  },
];

const roleOrder = ["Managing Trustee", "Secretary", "Treasurer", "Trustee"];
---

<section id="trustees" class="trustees-section section-pad">
  <div class="section-container">

    <!-- Header -->
    <div class="trustees-header">
      <span class="section-eyebrow">
        <span class="lang-en">Leadership</span>
        <span class="lang-ta">தலைமை</span>
      </span>
      <h2 class="section-title">
        <span class="lang-en">Our Board of Trustees</span>
        <span class="lang-ta">எங்கள் அறங்காவலர் குழு</span>
      </h2>
      <p class="section-desc">
        <span class="lang-en">Registered under the Tamil Nadu Public Trusts Act, 2018 — Reg. No. 143/2018</span>
        <span class="lang-ta">தமிழ்நாடு பொதுநல அறக்கட்டளை சட்டம் 2018 கீழ் பதிவு செய்யப்பட்டது — பதிவு எண். 143/2018</span>
      </p>
    </div>

    <!-- Trustees Grid -->
    <div class="trustees-grid">
      {trustees.map((t, i) => (
        <div class="trustee-card" style={`animation-delay: ${i * 0.07}s`}>
          <div class={`trustee-avatar ${t.color}`}>
            <span class="lang-en">{t.initials}</span>
            <span class="lang-ta">{t.initialsTA}</span>
          </div>

          <!-- Role badge -->
          <span class={`trustee-role-badge ${t.role === 'Managing Trustee' ? 'badge-primary' : t.role === 'Secretary' ? 'badge-blue' : t.role === 'Treasurer' ? 'badge-green' : 'badge-neutral'}`}>
            <span class="lang-en">{t.role}</span>
            <span class="lang-ta">{t.roleTA}</span>
          </span>

          <!-- Name -->
          <h3 class="trustee-name">
            <span class="lang-en">{t.name}</span>
            <span class="lang-ta">{t.nameTA}</span>
          </h3>

          <!-- Parent -->
          <p class="trustee-parent">{t.parent}</p>

          <!-- City -->
          <div class="trustee-city">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            {t.city}
          </div>
        </div>
      ))}
    </div>

    <!-- Reg note -->
    <div class="trustees-footer-note">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1E3A8A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      <span class="lang-en">All trustees serve voluntarily. The trust is administered transparently in accordance with Tamil Nadu law.</span>
      <span class="lang-ta">அனைத்து அறங்காவலர்களும் தன்னார்வமாக பணியாற்றுகின்றனர். அறக்கட்டளை தமிழ்நாடு சட்டத்தின்படி வெளிப்படையாக நிர்வகிக்கப்படுகிறது.</span>
    </div>

  </div>
</section>

<style>
  .trustees-section {
    background: #F9FAFB;
    border-top: 1px solid #E5E7EB;
  }

  .trustees-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3rem;
  }

  /* Grid — 3 columns desktop, 2 tablet, 1 mobile */
  .trustees-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  /* Card */
  .trustee-card {
    background: white;
    border: 1px solid #E5E7EB;
    border-radius: 20px;
    padding: 2rem 1.5rem 1.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    animation: fadeInUp 0.55s ease both;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .trustee-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #C2410C, #1E3A8A);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
  }

  .trustee-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.1);
  }

  .trustee-card:hover::after {
    transform: scaleX(1);
  }

  /* Avatar circle */
  .trustee-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    font-weight: 800;
    color: white;
    margin: 0 auto 1rem;
    letter-spacing: 0.02em;
    box-shadow: 0 4px 14px rgba(0,0,0,0.15);
  }

  .avatar-orange { background: linear-gradient(135deg, #C2410C, #EA580C); }
  .avatar-blue   { background: linear-gradient(135deg, #1E3A8A, #2563EB); }
  .avatar-green  { background: linear-gradient(135deg, #166534, #16A34A); }
  .avatar-purple { background: linear-gradient(135deg, #6B21A8, #9333EA); }
  .avatar-teal   { background: linear-gradient(135deg, #0F766E, #14B8A6); }
  .avatar-rose   { background: linear-gradient(135deg, #9F1239, #E11D48); }

  /* Role badge */
  .trustee-role-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
    margin-bottom: 0.75rem;
  }

  .badge-primary { background: #FFF7ED; color: #C2410C; border: 1px solid #FDBA74; }
  .badge-blue    { background: #EFF6FF; color: #1E3A8A; border: 1px solid #BFDBFE; }
  .badge-green   { background: #F0FDF4; color: #166534; border: 1px solid #86EFAC; }
  .badge-neutral { background: #F9FAFB; color: #374151; border: 1px solid #E5E7EB; }

  /* Name */
  .trustee-name {
    font-family: 'Playfair Display', 'Noto Serif Tamil', serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: #1C1917;
    margin-bottom: 0.3rem;
    line-height: 1.3;
  }

  /* Parent */
  .trustee-parent {
    font-size: 0.78rem;
    color: #9CA3AF;
    margin-bottom: 0.75rem;
    font-style: italic;
  }

  /* City */
  .trustee-city {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    color: #6B7280;
    font-weight: 500;
    background: #F9FAFB;
    padding: 0.3rem 0.8rem;
    border-radius: 100px;
    border: 1px solid #E5E7EB;
  }

  /* Footer note */
  .trustees-footer-note {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    max-width: 640px;
    margin: 0 auto;
    background: #EFF6FF;
    border: 1px solid #BFDBFE;
    border-radius: 10px;
    padding: 0.9rem 1.25rem;
    font-size: 0.85rem;
    color: #1E3A8A;
    line-height: 1.6;
  }

  .trustees-footer-note svg { flex-shrink: 0; margin-top: 2px; }

  /* Responsive */
  @media (max-width: 1023px) {
    .trustees-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .trustees-grid { grid-template-columns: 1fr; gap: 1rem; }
    .trustee-card { padding: 1.5rem; }
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
