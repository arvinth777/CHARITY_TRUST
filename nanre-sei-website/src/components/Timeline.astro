---
// src/components/Timeline.astro
import { siteConfig } from '../config/site';
const { timeline, mapLocations } = siteConfig;

const categoryLabels: Record<string, { en: string; ta: string }> = {
  all:      { en: 'All', ta: 'அனைத்தும்' },
  mobility: { en: '🚲 Mobility', ta: '🚲 இயக்கம்' },
  books:    { en: '📚 Books', ta: '📚 புத்தகங்கள்' },
  tuition:  { en: '🏫 Tuition', ta: '🏫 பயிற்சி' },
  aid:      { en: '💰 Aid', ta: '💰 உதவி' },
  digital:  { en: '💻 Digital', ta: '💻 டிஜிட்டல்' },
  events:   { en: '🏆 Events', ta: '🏆 நிகழ்வுகள்' },
};
---

<section id="timeline" class="timeline-section section-pad">
  <div class="section-container">
    <!-- Heading -->
    <div class="timeline-header">
      <span class="section-eyebrow">
        <span class="lang-en">Our Journey</span>
        <span class="lang-ta">எங்கள் பயணம்</span>
      </span>
      <h2 class="section-title">
        <span class="lang-en">Year by Year — 2018 to 2026</span>
        <span class="lang-ta">ஆண்டு வாரியாக — 2018 முதல் 2026 வரை</span>
      </h2>
    </div>

    <!-- Category Filter Buttons -->
    <div class="timeline-filters" role="group" aria-label="Filter timeline by category">
      {Object.entries(categoryLabels).map(([key, label]) => (
        <button
          class={`filter-btn ${key === 'all' ? 'active' : ''}`}
          data-filter={key}
          id={`filter-${key}`}
        >
          <span class="lang-en">{label.en}</span>
          <span class="lang-ta">{label.ta}</span>
        </button>
      ))}
    </div>

    <!-- Timeline -->
    <div class="timeline-track" id="timeline-track">
      {timeline.map((entry, i) => (
        <div
          class={`timeline-entry ${i % 2 === 0 ? 'left' : 'right'}`}
          data-category={entry.category}
          id={`year-${entry.year}`}
        >
          <!-- Year Badge (center dot) -->
          <div class="timeline-dot">
            <div class="timeline-dot-inner"></div>
          </div>

          <!-- Card -->
          <div class="timeline-card">
            <div class="timeline-year-badge">{entry.year}</div>
            <h3 class="timeline-card-title">
              <span class="lang-en">{entry.title.en}</span>
              <span class="lang-ta">{entry.title.ta}</span>
            </h3>
            <p class="timeline-card-desc">
              <span class="lang-en">{entry.description.en}</span>
              <span class="lang-ta">{entry.description.ta}</span>
            </p>
            {entry.photos.length > 0 && (
              <div class="timeline-photos">
                {entry.photos.map(photo => (
                  <div class="timeline-photo-wrap">
                    <img
                      src={photo.src}
                      alt=""
                      width="200"
                      height="160"
                      loading="lazy"
                      class="timeline-photo"
                    />
                    <div class="timeline-photo-overlay">
                      <span class="lang-en">{photo.alt.en}</span>
                      <span class="lang-ta">{photo.alt.ta}</span>
                    </div>
                  </div>
                ))}
              </div>
            )}
            <span class={`timeline-category-tag cat-${entry.category}`}>
              <span class="lang-en">{categoryLabels[entry.category]?.en.replace(/^[^\s]+\s/, '')}</span>
              <span class="lang-ta">{categoryLabels[entry.category]?.ta.replace(/^[^\s]+\s/, '')}</span>
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Map Section -->
  <div class="map-section">
    <div class="section-container">
      <h3 class="map-heading">
        <span class="lang-en">Where We Work — Coimbatore & Around</span>
        <span class="lang-ta">நாங்கள் பணியாற்றும் இடங்கள் — கோயம்புத்தூர் & சுற்றியுள்ள பகுதிகள்</span>
      </h3>
      <div id="trust-map" style="height: 420px; border-radius: 16px; overflow: hidden; border: 2px solid #E5E7EB;"></div>
    </div>
  </div>
</section>

<!-- Leaflet JS -->
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

<script is:inline>
  // Timeline filter
  const filterBtns = document.querySelectorAll('.filter-btn');
  const entries = document.querySelectorAll('.timeline-entry');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      entries.forEach(entry => {
        const cat = entry.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          entry.style.display = '';
          entry.style.opacity = '0';
          requestAnimationFrame(() => {
            entry.style.transition = 'opacity 0.4s ease';
            entry.style.opacity = '1';
          });
        } else {
          entry.style.display = 'none';
        }
      });
    });
  });

  // Map initialisation (delayed to avoid blocking render)
  setTimeout(() => {
    if (typeof L === 'undefined') return;
    
    const map = L.map('trust-map').setView([11.0168, 76.9558], 11);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
      maxZoom: 18,
    }).addTo(map);

    const locations = [
      { name: 'Veeriyampalayam', lat: 11.0524, lng: 77.0437, programs: ['Bicycles'], year: '2020' },
      { name: 'Singanallur / Rangapuram', lat: 11.0000, lng: 77.0280, programs: ['Books', 'Bags', 'Bicycles'], year: '2020, 2022' },
      { name: 'Nalli Chetti Palayam, Annur', lat: 11.2400, lng: 77.1000, programs: ['Evening Tuition'], year: '2025' },
      { name: 'Madukkarai Market', lat: 10.9000, lng: 76.9000, programs: ['Competitions'], year: '2026' },
      { name: 'Uppilipalayam', lat: 11.0450, lng: 77.0200, programs: ['Digital Access'], year: '2022' },
      { name: 'Nehru Nagar, Palakkara', lat: 11.0600, lng: 77.0650, programs: ['Financial Aid'], year: '2021' },
      { name: 'Guniyamuthur', lat: 11.0200, lng: 76.9300, programs: ['Evening Tuition'], year: '2025' },
      { name: 'Thirumurthi Nagar', lat: 11.0350, lng: 77.0500, programs: ['Evening Tuition'], year: '2025' },
      { name: 'Aathupalayam, Karumbukadai', lat: 11.0150, lng: 77.0100, programs: ['Evening Tuition'], year: '2025' },
    ];

    const customIcon = L.divIcon({
      html: '<div style="background:#C2410C;width:14px;height:14px;border-radius:50%;border:3px solid white;box-shadow:0 2px 6px rgba(0,0,0,0.3)"></div>',
      className: '',
      iconSize: [14, 14],
      iconAnchor: [7, 7],
    });

    locations.forEach(loc => {
      const marker = L.marker([loc.lat, loc.lng], { icon: customIcon }).addTo(map);
      marker.bindPopup(`
        <div style="font-family:Lato,sans-serif;min-width:160px">
          <strong style="color:#C2410C;font-size:0.95rem">${loc.name}</strong>
          <br/><span style="color:#6B7280;font-size:0.82rem">${loc.programs.join(', ')}</span>
          <br/><span style="color:#1E3A8A;font-size:0.82rem;font-weight:600">Year: ${loc.year}</span>
        </div>
      `, { maxWidth: 220 });
    });
  }, 800);
</script>

<style>
  .timeline-section {
    background: white;
  }

  .timeline-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 2.5rem;
  }

  /* Filters */
  .timeline-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-bottom: 3.5rem;
  }

  .filter-btn {
    padding: 0.5rem 1.2rem;
    border-radius: 100px;
    border: 1.5px solid #E5E7EB;
    background: white;
    color: #374151;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: 'Lato', 'Noto Sans Tamil', sans-serif;
  }

  .filter-btn:hover {
    border-color: #C2410C;
    color: #C2410C;
  }

  .filter-btn.active {
    background: #C2410C;
    border-color: #C2410C;
    color: white;
  }

  /* Timeline Track */
  .timeline-track {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
  }

  /* Vertical Spine */
  .timeline-track::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 3px;
    background: linear-gradient(to bottom, #C2410C, #1E3A8A);
    border-radius: 3px;
  }

  /* Entry */
  .timeline-entry {
    display: flex;
    align-items: flex-start;
    margin-bottom: 3.5rem;
    position: relative;
  }

  .timeline-entry.left {
    flex-direction: row-reverse;
  }

  .timeline-entry.left .timeline-card {
    margin-right: 3rem;
    text-align: left;
  }

  .timeline-entry.right .timeline-card {
    margin-left: 3rem;
  }

  /* Dot */
  .timeline-dot {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    top: 1.5rem;
  }

  .timeline-dot-inner {
    width: 20px;
    height: 20px;
    background: #C2410C;
    border: 4px solid white;
    border-radius: 50%;
    box-shadow: 0 0 0 2px #C2410C;
    transition: transform 0.3s ease;
  }

  .timeline-entry:hover .timeline-dot-inner {
    transform: scale(1.4);
  }

  /* Card */
  .timeline-card {
    background: white;
    border: 1px solid #E5E7EB;
    border-radius: 16px;
    padding: 1.75rem;
    width: calc(50% - 3rem);
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    transition: all 0.3s ease;
    position: relative;
  }

  .timeline-card::before {
    content: '';
    position: absolute;
    top: 1.75rem;
    width: 0;
    height: 0;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
  }

  .timeline-entry.left .timeline-card::before {
    right: -18px;
    border-left: 18px solid white;
  }

  .timeline-entry.right .timeline-card::before {
    left: -18px;
    border-right: 18px solid white;
  }

  .timeline-card:hover {
    box-shadow: 0 12px 32px rgba(0,0,0,0.12);
    transform: translateY(-3px);
  }

  .timeline-year-badge {
    display: inline-block;
    background: linear-gradient(135deg, #C2410C, #9A3412);
    color: white;
    font-size: 1rem;
    font-weight: 800;
    padding: 0.25rem 1rem;
    border-radius: 100px;
    margin-bottom: 0.85rem;
    letter-spacing: 0.05em;
  }

  .timeline-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1C1917;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .timeline-card-desc {
    font-size: 0.9rem;
    color: #6B7280;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  /* Photos */
  .timeline-photos {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .timeline-photo-wrap {
    position: relative;
    width: 100px;
    height: 80px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .timeline-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .timeline-photo-wrap:hover .timeline-photo {
    transform: scale(1.08);
  }

  .timeline-photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 40%, rgba(0,0,0,0.6));
    display: flex;
    align-items: flex-end;
    padding: 0.3rem;
    font-size: 0.65rem;
    color: white;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .timeline-photo-wrap:hover .timeline-photo-overlay {
    opacity: 1;
  }

  /* Category tag */
  .timeline-category-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.65rem;
    border-radius: 100px;
  }

  .cat-mobility { background: #FFF7ED; color: #C2410C; }
  .cat-aid      { background: #FEF9C3; color: #854D0E; }
  .cat-digital  { background: #EFF6FF; color: #1E3A8A; }
  .cat-tuition  { background: #F0FDF4; color: #166534; }
  .cat-events   { background: #FDF4FF; color: #7E22CE; }

  /* Map */
  .map-section {
    background: #F9FAFB;
    padding-block: 3.5rem;
    margin-top: 3rem;
  }

  .map-heading {
    font-family: 'Playfair Display', 'Noto Serif Tamil', serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #1C1917;
    text-align: center;
    margin-bottom: 1.5rem;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .timeline-track::before {
      left: 20px;
    }

    .timeline-entry,
    .timeline-entry.left {
      flex-direction: row;
    }

    .timeline-dot {
      left: 20px;
      top: 1.5rem;
    }

    .timeline-card,
    .timeline-entry.left .timeline-card,
    .timeline-entry.right .timeline-card {
      width: calc(100% - 60px);
      margin-left: 55px;
      margin-right: 0;
    }

    .timeline-entry.left .timeline-card::before,
    .timeline-entry.right .timeline-card::before {
      left: -18px;
      right: auto;
      border-right: 18px solid white;
      border-left: none;
    }
  }

  @media (max-width: 480px) {
    .timeline-photo-wrap { width: 80px; height: 65px; }
    .timeline-card { padding: 1.25rem; }
  }
</style>
